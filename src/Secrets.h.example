#pragma once

// Personal-use build: everything hardcoded, no captive portal.
// Copy this file to Secrets.h and fill in your own values.
// Secrets.h is gitignored and must never be committed.

// Wi-Fi Credentials
#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// OpenSky Network OAuth2 client credentials (client-credentials grant) — set
// to raise the request quota above the unauthenticated limit.
#define OPENSKY_CLIENT_ID     "your-opensky-client-id"
#define OPENSKY_CLIENT_SECRET "your-opensky-client-secret"

// Home Location (radar center)
#define HOME_LAT 0.0
#define HOME_LON 0.0
